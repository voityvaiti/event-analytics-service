#!/bin/bash

# Mint a tenant token using the pinned Node container; requires Docker. The tenant
# scopes ingestion and stats; an optional scope, e.g. persistence:control, grants the
# service endpoints.
#
# TOKEN=$(scripts/actions/mint-token acme)
#
# curl -H "Authorization: Bearer $TOKEN" localhost:8080/api/v1/stats/event-counts?...

set -euo pipefail
cd "$(dirname "$0")/../.." || exit 1

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "Usage: scripts/actions/mint-token <tenant> [scope]" >&2
  exit 1
fi

NODE_IMAGE=${NODE_IMAGE:-node:22-alpine}

docker run --rm \
  --volume "$PWD":/work --workdir /work \
  "$NODE_IMAGE" node perf/lib/mint-token.mjs "$@"
