#!/bin/bash

# Start Prometheus (localhost:9090) and Grafana (localhost:3000) through the
# observability Compose profile. The profile keeps these extra workloads out of normal
# dependency startup.
#
# Start the host app separately; Prometheus uses the host gateway. Pass down to stop
# observability while leaving Postgres running.

set -euo pipefail
cd "$(dirname "$0")/../.." || exit 1

if [[ "${1:-}" == "down" ]]; then
  exec docker compose stop grafana prometheus
fi

docker compose --profile observability up -d --wait "$@"

# Import all journal annotations on startup, including runs measured while Grafana was
# down. Sync is idempotent and non-fatal: a partial or unreadable journal must not fail
# stack startup under set -e or xargs.
find perf -name journal.jsonl -print0 | xargs -0 -r perf/lib/annotate-runs.sh || true
