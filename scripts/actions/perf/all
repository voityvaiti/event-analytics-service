#!/bin/bash

# Run all write, read, and mixed cells and print one digest. Lists come from
# perf/<path>/tests.sh. Each cell updates its journal; review and commit those
# separately.

set -euo pipefail
cd "$(dirname "$0")/../../.." || exit 1

source perf/lib/harness.sh
source perf/write/tests.sh
source perf/read/tests.sh
source perf/mixed/tests.sh

perf_bootstrap
perf_run_tests "${WRITE_TESTS[@]}" "${READ_TESTS[@]}" "${MIXED_TESTS[@]}"
