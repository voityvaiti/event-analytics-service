#!/bin/bash

# Launch the packaged app with unrestricted JIT; bootRun's C1 limit loses ~15% write
# throughput and is rejected by the harness. Start Compose and configure the datasource
# explicitly because the jar lacks spring-boot-docker-compose. Run in the foreground
# until Ctrl-C.
#
# Pass app arguments directly, e.g. scripts/actions/perf/app --server.port=9090.

set -euo pipefail
cd "$(dirname "$0")/../../.." || exit 1

scripts/actions/dependencies

./gradlew bootJar

jar=$(find build/libs -name '*-SNAPSHOT.jar' ! -name '*-plain.jar' -print -quit)
if [ -z "$jar" ]; then
  echo "No boot jar in build/libs — did bootJar run?" >&2
  exit 1
fi

# Stamp the jar's build commit rather than the later checkout state. Add -dirty only for
# changes in bootJar inputs; journals and README edits do not affect it.
#
# Write before exec. A failed launch can leave a stamp newer than the still-serving
# process, so the harness checks its age before trusting it.
build_commit=$(git rev-parse --short HEAD)
if [ -n "$(git status --porcelain -- src/main build.gradle settings.gradle gradle)" ]; then
  build_commit="$build_commit-dirty"
fi
printf '%s\n' "$build_commit" > "$jar.commit"

exec java -jar "$jar" \
  --spring.datasource.url=jdbc:postgresql://localhost:5432/event_analytics \
  --spring.datasource.username=event_analytics \
  --spring.datasource.password=event_analytics \
  "$@"
