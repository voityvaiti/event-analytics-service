#!/bin/bash

# Measure steady ingestion during an active-users read surge. Append one row per round
# to perf/mixed/spike/active-users/journal.jsonl; report without a recovery gate.
# Measurement errors still fail. Start the app with scripts/actions/perf/app.
#
# Tunables: WRITE_RATE, WRITE_TIMEOUT_SECONDS, WRITE_MAX_VUS, READ_SPIKE_RATE,
# READ_BASELINE_RATE, READ_MAX_VUS, GROUP_BY, SPIKE_WINDOW, *_SECONDS, ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/mixed/spike/measure-cell.sh
source perf/mixed/spike/active-users/measure.sh

perf_bootstrap
perf_run_tests "mixed spike active-users:perf_mixed_spike_active_users"
