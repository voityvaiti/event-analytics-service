#!/bin/bash

# PERF - Read Load event-counts: measure read latency for the
# /api/v1/stats/event-counts endpoint against the seeded corpus and append its
# journal rows, one per grouping per round. The app must already be running on the
# host; backing services and the corpus are brought up by the harness. Tunables:
# VUS, DURATION, ROUNDS (default 1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/read/load/measure-cell.sh
source perf/read/load/event-counts/measure.sh

perf_bootstrap
perf_run_tests "read load event-counts:perf_read_load_event_counts"
