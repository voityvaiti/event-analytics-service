#!/bin/bash

# PERF - Read Spike: step the dashboard request rate far above what the pool can
# serve, then back down, and check the read path recovers. Appends one row to
# perf/read/spike/journal.jsonl. Exits non-zero if the app did not recover. The
# app must already be running on the host. Tunables: ENDPOINT, GROUP_BY,
# SPIKE_WINDOW, BASELINE_RATE, SPIKE_RATE, *_SECONDS, MAX_VUS.

set -euo pipefail
cd "$(dirname "$0")/../../../.." || exit 1

source perf/lib/harness.sh
source perf/read/spike/measure.sh

perf_bootstrap

status=0
perf_read_spike || status=$?
perf_report

echo "Eyeball the appended journal line above, then commit it yourself."
exit "$status"
