#!/bin/bash

# PERF - Read Spike active-users: step the dashboard request rate far above what
# the pool can serve, then back down, and check the read path recovers. Appends
# one row per round to perf/read/spike/active-users/journal.jsonl. Exits non-zero
# if the app did not recover; the digest line carries which of the two it was. The
# app must already be running on the host. Tunables: ENDPOINT, GROUP_BY,
# SPIKE_WINDOW, BASELINE_RATE, SPIKE_RATE, *_SECONDS, MAX_VUS, ROUNDS (default 1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/read/spike/active-users/measure.sh

perf_bootstrap
perf_run_tests "read spike active-users:perf_read_spike_active_users"
