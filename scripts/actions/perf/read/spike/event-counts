#!/bin/bash

# Measure event-counts surge and recovery; append to
# perf/read/spike/event-counts/journal.jsonl. Recovery is informational; only
# measurement errors fail. Requires scripts/actions/perf/app.
#
# Tunables: SPIKE_RATE, GROUP_BY, SPIKE_WINDOW, BASELINE_RATE, *_SECONDS, MAX_VUS,
# ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/read/spike/measure-cell.sh
source perf/read/spike/event-counts/measure.sh

perf_bootstrap
perf_run_tests "read spike event-counts:perf_read_spike_event_counts"
