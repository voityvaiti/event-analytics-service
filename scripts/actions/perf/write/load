#!/bin/bash

# PERF - Load: measure steady-state ingest write throughput and append one row
# to perf/write/load/journal.jsonl. The app must already be running on the host;
# backing services are brought up by the harness. Tunables: VUS, DURATION.

set -euo pipefail
cd "$(dirname "$0")/../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/load/measure.sh

perf_bootstrap

status=0
perf_load || status=$?
perf_report

echo "Eyeball the appended journal line above, then commit it yourself."
exit "$status"