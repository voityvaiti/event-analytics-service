#!/bin/bash

# Measure batch throughput in events/s; append one row per round to
# perf/write/load/batch/journal.jsonl. Requires scripts/actions/perf/app. Repeated
# rounds report this cell's spread.
#
# Tunables: VUS, DURATION, BATCH_SIZE, ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/load/measure-cell.sh
source perf/write/load/batch/measure.sh

perf_bootstrap
perf_run_tests "write load batch:perf_write_load_batch"
