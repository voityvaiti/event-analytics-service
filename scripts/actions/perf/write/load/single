#!/bin/bash

# Measure single-event throughput; append one row per round to
# perf/write/load/single/journal.jsonl. Requires scripts/actions/perf/app. Repeated
# rounds report spread.
#
# Tunables: VUS, DURATION, ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/load/measure-cell.sh
source perf/write/load/single/measure.sh

perf_bootstrap
perf_run_tests "write load single:perf_write_load_single"
