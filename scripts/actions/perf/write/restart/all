#!/bin/bash

# PERF - Write Restart: run every consumer stop/restart cell back to back and print one
# combined digest. The cell list lives in perf/write/tests.sh. Tunables: RATE,
# BASELINE_SECONDS, DOWNTIME_SECONDS, AFTER_SECONDS, DRAIN_BUDGET_SECONDS, ROUNDS
# (default 1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/tests.sh

perf_bootstrap
perf_run_tests "${WRITE_RESTART_TESTS[@]}"
