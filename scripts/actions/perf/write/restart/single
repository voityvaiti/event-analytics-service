#!/bin/bash

# Stop the persistence consumer for 60 s under single-event intake, restart it, and
# judge the drain; append to perf/write/restart/single/journal.jsonl and its lag curve
# to lag.jsonl. Requires scripts/actions/perf/app, which enables consumer control.
#
# Tunables: RATE (1000), WRITE_TIMEOUT_SECONDS (1), BASELINE_SECONDS, DOWNTIME_SECONDS,
# AFTER_SECONDS, DRAIN_BUDGET_SECONDS, ROUNDS (1), SATURATION (on).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/restart/measure-cell.sh
source perf/write/restart/single/measure.sh

perf_bootstrap
perf_run_tests "write restart single:perf_write_restart_single"
