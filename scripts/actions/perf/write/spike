#!/bin/bash

# PERF - Write Spike: step the ingest rate far above steady-state capacity, then
# back down, and check the app recovers. Appends one row per round to
# perf/write/spike/journal.jsonl. Exits non-zero if the app did not recover after
# the surge. The app must already be running on the host. Tunables:
# BASELINE_RATE, SPIKE_RATE, *_SECONDS, MAX_VUS, ROUNDS (default 1).

set -euo pipefail
cd "$(dirname "$0")/../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/spike/measure.sh

perf_bootstrap
perf_run_tests "write spike:perf_spike"
