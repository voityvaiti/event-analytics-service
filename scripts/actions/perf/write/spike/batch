#!/bin/bash

# Measure batch surge and recovery; append to perf/write/spike/batch/journal.jsonl and
# fail on unsuccessful recovery. See the cell README for baseline and surge calibration.
# Requires scripts/actions/perf/app.
#
# Tunables: SPIKE_RATE, BATCH_SIZE, BASELINE_RATE, *_SECONDS, MAX_VUS, ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/spike/measure-cell.sh
source perf/write/spike/batch/measure.sh

perf_bootstrap
perf_run_tests "write spike batch:perf_write_spike_batch"
