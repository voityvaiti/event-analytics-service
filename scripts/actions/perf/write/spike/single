#!/bin/bash

# Measure single-event surge and recovery; append to
# perf/write/spike/single/journal.jsonl and fail on unsuccessful recovery. Requires
# scripts/actions/perf/app.
#
# Tunables: SPIKE_RATE, BASELINE_RATE, *_SECONDS, MAX_VUS, ROUNDS (1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/spike/measure-cell.sh
source perf/write/spike/single/measure.sh

perf_bootstrap
perf_run_tests "write spike single:perf_write_spike_single"
