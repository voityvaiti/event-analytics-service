#!/bin/bash

# PERF - Write Steady: run every write steady cell back to back and print one combined
# digest. The cell list lives in perf/write/tests.sh. Tunables: RATE,
# WRITE_TIMEOUT_SECONDS, MAX_VUS, PHASES, ROUNDS (default 1).

set -euo pipefail
cd "$(dirname "$0")/../../../../.." || exit 1

source perf/lib/harness.sh
source perf/write/tests.sh

perf_bootstrap
perf_run_tests "${WRITE_STEADY_TESTS[@]}"
