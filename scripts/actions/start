#!/bin/bash

# Start development bootRun in the foreground. spring-boot-docker-compose starts
# dependencies and waits for health; perf measurements require scripts/actions/perf/app
# instead.
#
# Pass Gradle arguments directly, e.g. scripts/actions/start
# --args='--server.port=9090'.

set -euo pipefail
cd "$(dirname "$0")/../.." || exit 1
./gradlew bootRun "$@"